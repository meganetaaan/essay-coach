{
  "name": "@essay-coach/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "migration:summary": "node scripts/summarize-sqlite-migration.mjs",
    "d1:migrations:list": "wrangler d1 migrations list essay-coach-prod --config wrangler.jsonc",
    "d1:migrations:apply:local": "wrangler d1 migrations apply essay-coach-prod --local --config wrangler.jsonc",
    "worker:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "worker:deploy:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.93.0"
  }
}
