{
  "name": "@essay-coach/review-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @essay-coach/backend build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "pnpm --filter @essay-coach/backend build && tsx src/index.ts"
  },
  "dependencies": {
    "@essay-coach/backend": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
